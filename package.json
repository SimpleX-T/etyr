{
  "name": "etyr",
  "version": "1.0.0",
  "description": "Etyr — Understand the web as you read it.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:chrome",
    "build:chrome": "vite build --mode production && vite build --config vite.content.config.ts",
    "build:firefox": "npm run build && node scripts/prepare-firefox.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ --ext .ts,.tsx",
    "generate-icons": "node scripts/generate-icons.mjs",
    "prebuild": "npm run generate-icons"
  },
  "dependencies": {
    "@fontsource/lora": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "lucide-react": "^0.460.0",
    "motion": "^13.3.0",
    "preact": "^10.29.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/chrome": "^0.0.287",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/ui": "^2.1.0",
    "eslint": "^9.0.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.0",
    "sharp": "^0.33.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
